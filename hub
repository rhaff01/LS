    local function buildPack(desc)
        local pack = {desc = desc, acc = {}, classic = {}, colors = nil, charMeshes = {}}
        local Loader = Instance.new("Model")
        Loader.Name = "RoClothesAvatarLoader"
        Loader.Parent = game
        local H = Instance.new("Humanoid")
        H.Parent = Loader
        pcall(function() H:ApplyDescription(desc) end)
        local t0 = os.clock()
        repeat task.wait() until #Loader:GetChildren() > 2 or not Loader.Parent or os.clock() - t0 > 6
        task.wait(0.6)
        for _, v in ipairs(Loader:GetChildren()) do
            if v:IsA("Accessory") then
                table.insert(pack.acc, v:Clone())
            elseif v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") then
                pack.classic[v.ClassName] = v:Clone()
            elseif v:IsA("BodyColors") then
                pack.colors = v:Clone()
            end
        end
        Loader:Destroy()
        pcall(function()
            local LA = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R6)
            local Head = LA:WaitForChild("Head", 10)
            if Head then
                local f = Head:FindFirstChildOfClass("Decal")
                local m = Head:FindFirstChildOfClass("SpecialMesh")
                if f then pack.face = f:Clone() end
                if m then pack.headMesh = m:Clone() end
            end
            for _, c in ipairs(LA:GetChildren()) do
                if c:IsA("CharacterMesh") then table.insert(pack.charMeshes, c:Clone()) end
            end
            LA:Destroy()
        end)
        return pack
    end

    local function reloadAnimate(char)
        local anim = char:FindFirstChild("Animate")
        if anim then
            anim.Enabled = false
            task.wait()
            anim.Enabled = true
        end
