        for _, ext in ipairs({".com", ".net", ".org", ".io", ".gg", ".xyz", ".me", ".ly"}) do
            if low:find(ext, 1, true) then return true end
        end
        return false
    end

    local function isSpam(msg)
        local prev, run, sym = nil, 0, 0
        local ok = pcall(function()
            for _, cp in utf8.codes(msg) do
                if cp == prev then run += 1 else run = 1 end
                prev = cp
                if run >= 6 then error("spam") end
                local punct = (cp >= 33 and cp <= 47) or (cp >= 58 and cp <= 64) or (cp >= 91 and cp <= 96) or (cp >= 123 and cp <= 126)
                if punct then sym += 1 else sym = 0 end
                if sym >= 5 then error("spam") end
            end
        end)
        return not ok
    end

    local function checkChat(msg, last)
        if msg == "" then return "Empty message" end
        local len = utf8.len(msg) or #msg
        if len > 200 then return "Message too long" end
        local low = msg:lower()
        if hasLink(low) or low:find("@everyone", 1, true) or low:find("@here", 1, true) then return "Links are not allowed" end
        if isSpam(msg) then return "Spam detected" end
        if last and last == msg then return "Duplicate message" end
        return nil
    end

    local function checkReport(msg, last)
        if msg == "" then return "Empty message" end
        local len = utf8.len(msg) or #msg
        if len < 15 then return "Too short (describe the problem clearly)" end
        if len > 400 then return "Message too long" end
        local low = msg:lower()
        if low:find("@everyone", 1, true) or low:find("@here", 1, true) then return "Spam detected" end
        if isSpam(msg) then return "Spam detected" end
        if last and last == msg then return "Duplicate message" end
        return nil
    end

    local function dayKey() return os.date("%Y-%m-%d") end

    local function usage(cfg)
        if S[cfg.dayKey] ~= dayKey() then
            S[cfg.dayKey] = dayKey()
            S[cfg.cntKey] = 0
        end
        local left = cfg.daily - (S[cfg.cntKey] or 0)
        local wait = cfg.cooldown - (os.time() - (S[cfg.lastKey] or 0))
        return math.max(0, left), math.max(0, wait)
    end

    local function build(key, cfg)
        local p = makePage(Enum.ScrollingDirection.Y, CW + 24, 0)
        local yy = 10
        local R = makeCard(p, 12, yy, CW, cfg.rulesH, cfg.rulesTitle)
        yy += cfg.rulesH + 10
        note(R, 36, cfg.rules, cfg.rulesH - 42)

        local M = makeCard(p, 12, yy, CW, 230, cfg.title)
        yy += 240
        local box = new("TextBox", {Position = UDim2.fromOffset(12, 38), Size = UDim2.new(1, -24, 0, 84), BackgroundTransparency = 0.2,
            Text = "", PlaceholderText = "Write your message...", Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = TEXT,
            ClearTextOnFocus = false, MultiLine = true, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top}, M)
        inputStyle(box)
        local countL = new("TextLabel", {BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 126), Size = UDim2.new(1, -24, 0, 14),
            Text = "0/" .. cfg.maxLen, Font = Enum.Font.Gotham, TextSize = 10, TextColor3 = SUB, TextXAlignment = Enum.TextXAlignment.Right}, M)
        local sendBtn = new("TextButton", {Position = UDim2.fromOffset(12, 144), Size = UDim2.new(1, -24, 0, 34), Text = "Send",
            Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = WHITE, AutoButtonColor = false}, M)
        corner(sendBtn, 10)
        bindAccent(sendBtn, "BackgroundColor3")
        local usageL = new("TextLabel", {BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 184), Size = UDim2.new(1, -24, 0, 14),
            Text = "", Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = TEXT, TextXAlignment = Enum.TextXAlignment.Left}, M)
        local resultL = new("TextLabel", {BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 200), Size = UDim2.new(1, -24, 0, 26),
            Text = "", Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = SUB, TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top}, M)

        local lastMsg, sending = nil, false
        local function renderUsage()
            local left, wait = usage(cfg)
            local s = T("Left today") .. ": " .. left .. "/" .. cfg.daily
            if wait > 0 then s = T("Next message in") .. " " .. wait .. "s  •  " .. s end
            usageL.Text = s
        end
        table.insert(langHooks, renderUsage)
        renderUsage()

        box:GetPropertyChangedSignal("Text"):Connect(function()
            countL.Text = (utf8.len(box.Text) or #box.Text) .. "/" .. cfg.maxLen
        end)

        local function result(txt, color)
            resultL.Text = txt
            resultL.TextColor3 = color or SUB
        end

        sendBtn.MouseButton1Click:Connect(function()
            if sending then return end
            local msg = box.Text:gsub("^%s+", ""):gsub("%s+$", "")
            local err = cfg.check(msg, lastMsg)
            if err then result(T(err), Color3.fromRGB(200, 60, 60)); return end
            local left, wait = usage(cfg)
            if left <= 0 then result(T("Daily limit reached"), Color3.fromRGB(200, 60, 60)); return end
            if wait > 0 then result(T("Please wait") .. " " .. wait .. "s", Color3.fromRGB(200, 60, 60)); return end
            sending = true
            result(T("Sending..."), SUB)
            local text = "[" .. player.Name .. "] : " .. msg
            if cfg.extra then text = text .. cfg.extra() end
            task.spawn(function()
                local ok, e = postWebhook(cfg.url, text)
                sending = false
                if ok then
                    S[cfg.cntKey] = (S[cfg.cntKey] or 0) + 1
                    S[cfg.lastKey] = os.time()
                    lastMsg = msg
                    save()
                    box.Text = ""
                    result(T("Sent ✓"), Color3.fromRGB(40, 160, 90))
                else
                    result(T("Failed to send") .. ": " .. tostring(e), Color3.fromRGB(200, 60, 60))
                end
                renderUsage()
            end)
        end)

        task.spawn(function()
            while alive do
                renderUsage()
                task.wait(1)
            end
        end)

        p.scroll.CanvasSize = UDim2.fromOffset(CW + 24, yy)
        pages[key] = p
    end

    build("report", {
        url = REPORT_URL, cooldown = 10, daily = 30, maxLen = 400, check = checkReport,
        dayKey = "repDay", cntKey = "repCount", lastKey = "repLast",
        title = "Report", rulesTitle = "Report rules", rulesH = 176,
        rules = "• Describe the problem clearly: when you report a bug, write exactly what happened to you.\n• Don't repeat the report: send one message only so it can be reviewed and fixed quickly.\n• Your Roblox name and the map ID are sent with the report.",
        extra = function() return "\nPlace: " .. string.format("%.0f", PID) end,
    })
    build("chat", {
        url = CHAT_URL, cooldown = 60, daily = 5, maxLen = 200, check = checkChat,
        dayKey = "chatDay", cntKey = "chatCount", lastKey = "chatLast",
        title = "Chat", rulesTitle = "Chat rules", rulesH = 176,
        rules = "• No spam: don't send heavily repeated messages or long runs of symbols that make reading hard.\n• Talk only: this space is for friendly conversation, not for ads or links.\n• Your Roblox name is sent with the message.",
    })
end)()

