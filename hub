            cmp = function(a, b) return (a.playing or 0) > (b.playing or 0) end},
        {name = "New (≤ 3 players)", pred = function(s) return (s.playing or 0) <= 3 end,
            cmp = function(a, b) return (a.playing or 0) < (b.playing or 0) end},
        {name = "Random", shuffle = true},
