        local CParentAttachment = CharacterAttachment[CAttachment.Name]

        if not CParentAttachment then
            CAccessory.Parent = Character
            v:Destroy()
            return CAccessory
        end

        if CSpecialMesh then
            local HandleParent = CParentAttachment.Parent
            local Size = HandleParent.Size
            local HandleSize = CHandle.Size
            local BodySize = BodyPartSize[HandleParent.Name] or BodyPartSize.Torso
            local CalcSize = Size
            local SpecialHead = false

            if HandleParent.Name == "Head" and HandleParent:IsA("MeshPart") then
                BodySize = BodyPartSize.HeadMeshFix
            elseif HandleParent.Name == "Head" and HandleParent:FindFirstChildOfClass("SpecialMesh") then
                local SM = HandleParent:FindFirstChildOfClass("SpecialMesh")

                if SM.MeshType == Enum.MeshType.Head then
                    SpecialHead = true
                    BodySize = BodyPartSize.HeadScale
                else
                    CalcSize = SM.Scale
                    BodySize = BodyPartSize.HeadScale
                end
            end

            local X, Y, Z = MultiplyCalculate(CalcSize, BodySize)

            if SpecialHead then
                if CalcSize.X > CalcSize.Z then
                    CalcSize = Vector3.new(CalcSize.Z, CalcSize.Y, CalcSize.Z)
                end

                if CalcSize.Z > CalcSize.X then
                    CalcSize = Vector3.new(CalcSize.X, CalcSize.Y, CalcSize.X)
                end

                X, Y, Z = MultiplyCalculate(CalcSize, BodySize)

                local SM = HandleParent:FindFirstChildOfClass("SpecialMesh")
                local S2 = SM.Scale

                if S2.X > S2.Z then
                    S2 = Vector3.new(S2.Z, S2.Y, S2.Z)
                end

                if S2.Z > S2.X then
                    S2 = Vector3.new(S2.X, S2.Y, S2.X)
                end

                local SX, SY, SZ = MultiplyCalculate(S2, Vector3.new(1.25, 1.25, 1.25))
                X, Y, Z = X * SX, Y * SY, Z * SZ
            end

            local CAttachCF = CAttachment.CFrame
            local PAttachCF = AttachmentCFrame[CParentAttachment.Name]
            local Scale = CSpecialMesh.Scale

            CHandle.Size = Vector3.new(HandleSize.X * X, HandleSize.Y * Y, HandleSize.Z * Z)
            CSpecialMesh.Scale = Vector3.new(Scale.X * X, Scale.Y * Y, Scale.Z * Z)
            CAttachment.CFrame = CFrame.new(CAttachCF.Position.X * X, CAttachCF.Position.Y * Y, CAttachCF.Position.Z * Z) * CAttachCF.Rotation
            CParentAttachment.CFrame = CFrame.new(PAttachCF.Position.X * X, PAttachCF.Position.Y * Y, PAttachCF.Position.Z * Z) * PAttachCF.Rotation
        end

        CHandle.CanCollide = false
        CHandle.CanQuery = false
        CHandle.CanTouch = false
        CHandle.Massless = true
        CHandle.CustomPhysicalProperties = PhysicalProperties.new(0.0001)

        CAccessory.Parent = Character
        v:Destroy()

        CHandle.CFrame = CParentAttachment.Parent.CFrame

        local Weld = Instance.new("Weld")
        Weld.Part0 = CHandle
        Weld.Part1 = CParentAttachment.Parent
        Weld.C0 = CAttachment.CFrame
        Weld.C1 = CParentAttachment.CFrame
        Weld.Parent = CHandle

        return CAccessory
    end

