local SV = {}
do
local lastHttpErr
local function httpGet(url)
    lastHttpErr = nil
    local reqf = (syn and syn.request) or http_request or request or (fluxus and fluxus.request)
    if reqf then
        local ok, res = pcall(reqf, {Url = url, Method = "GET"})
        if ok and type(res) == "table" then
            local code = res.StatusCode or res.status_code
            if (res.Success or code == 200) and type(res.Body) == "string" and #res.Body > 0 then return res.Body end
            lastHttpErr = "HTTP " .. tostring(code)
        elseif not ok then
            lastHttpErr = tostring(res)
        end
    end
    local ok, body = pcall(function() return game:HttpGet(url) end)
    if ok and type(body) == "string" and #body > 0 then return body end
    if not lastHttpErr then lastHttpErr = tostring(body) end
    return nil
end

local function fetchServers(placeId)
    placeId = placeId or game.PlaceId
    local lastE = "no response"
    for _, host in ipairs({"games.roblox.com", "games.roproxy.com"}) do
        local out, cursor = {}, nil
        for _ = 1, 2 do
            local url = string.format("https://%s/v1/games/%.0f/servers/Public?sortOrder=Desc&limit=100%s",
                host, placeId, cursor and ("&cursor=" .. cursor) or "")
            local body = httpGet(url)
            local res
            if body then
                local ok, r = pcall(function() return HttpService:JSONDecode(body) end)
                if ok then res = r end
            end
            if type(res) ~= "table" or type(res.data) ~= "table" then
                lastE = lastHttpErr or "bad response"
                if type(res) == "table" and res.errors and res.errors[1] then lastE = tostring(res.errors[1].message) end
                break
            end
            for _, s in ipairs(res.data) do
                if type(s) == "table" and s.id then table.insert(out, s) end
            end
            cursor = res.nextPageCursor
            if not cursor then break end
        end
        if #out > 0 then return out end
    end
    return nil, string.sub(tostring(lastE), 1, 70)
end

local function joinServer(id, placeId)
    hopping = true
    local ok, err = pcall(function() TeleportService:TeleportToPlaceInstance(placeId or game.PlaceId, id, player) end)
    if not ok then hopping = false; return false, tostring(err) end
    task.delay(20, function() hopping = false end)
    return true
end

local function pickServer(kind, list, placeId)
    local here = (placeId or game.PlaceId) == game.PlaceId
    local pool = {}
    for _, s in ipairs(list) do
        if (not here or s.id ~= game.JobId) and (s.playing or 0) < (s.maxPlayers or 0) then table.insert(pool, s) end
    end
    if #pool == 0 then return nil end
    if kind == "random" then return pool[math.random(#pool)] end
    if kind == "ping" then
        table.sort(pool, function(a, b) return (a.ping or 0) > (b.ping or 0) end)
        return pool[1]
    elseif kind == "full" then
        table.sort(pool, function(a, b) return (a.playing or 0) > (b.playing or 0) end)
        return pool[1]
    end
    table.sort(pool, function(a, b) return (a.playing or 0) < (b.playing or 0) end)
    if kind == "new" then
        local fresh = {}
        for _, s in ipairs(pool) do if (s.playing or 0) <= 3 then table.insert(fresh, s) end end
        if #fresh > 0 then return fresh[math.random(#fresh)] end
    end
    return pool[1]
end

local function quickJoin(kind, status, placeId)
    status.Text = T("Searching...")
    local list, err = fetchServers(placeId)
    if not list then
        if kind == "random" then
            status.Text = T("Fetch failed, joining normally...")
            SV.onFail = function(result) status.Text = T("Teleport failed") .. ": " .. tostring(result) end
            hopping = true
            local ok = pcall(function() TeleportService:Teleport(placeId or game.PlaceId, player) end)
            if not ok then hopping = false; status.Text = T("Teleport failed") end
            return
        end
        status.Text = T("Failed to load servers") .. ": " .. tostring(err)
        return
    end
    local s = pickServer(kind, list, placeId)
    if not s then status.Text = T("No server found"); return end
    status.Text = string.format("%s (%.0f/%.0f, %.0fms)", T("Joining..."), s.playing or 0, s.maxPlayers or 0, s.ping or 0)
    SV.onFail = function(result) status.Text = T("Teleport failed") .. ": " .. tostring(result) end
    local ok, e = joinServer(s.id, placeId)
    if not ok then status.Text = T("Teleport failed") .. ": " .. tostring(e) end
end

local function loadMapInfo(placeId)
    local name, image
    local ok, info = pcall(function() return MarketplaceService:GetProductInfo(placeId) end)
    if ok and info then
        name = info.Name
        if info.IconImageAssetId and info.IconImageAssetId ~= 0 then
            image = "rbxassetid://" .. string.format("%.0f", info.IconImageAssetId)
        end
    end
    if not image then
        local body = httpGet(string.format("https://apis.roblox.com/universes/v1/places/%.0f/universe", placeId))
        if body then
            local ok2, res = pcall(function() return HttpService:JSONDecode(body) end)
            if ok2 and type(res) == "table" and res.universeId then
                image = "rbxthumb://type=GameIcon&id=" .. string.format("%.0f", res.universeId) .. "&w=150&h=150"
            end
        end
    end
    return name, image
end

SV.fetch, SV.join, SV.pick, SV.quick, SV.mapInfo = fetchServers, joinServer, pickServer, quickJoin, loadMapInfo
end

