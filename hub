do
    local p = makePage(Enum.ScrollingDirection.Y, 0, 0)
    p.scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
    p.scroll.CanvasSize = UDim2.new()
    new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6)}, p.scroll)
    new("UIPadding", {PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 6), PaddingBottom = UDim.new(0, 6)}, p.scroll)

    local rows = {}
    local function setRowViewport(vp, plr)
        for _, c in ipairs(vp:GetChildren()) do
            if c:IsA("Model") or c:IsA("Camera") then c:Destroy() end
        end
        local char = plr.Character
        if not char or not char:FindFirstChild("Head") then return end
        pcall(function()
            char.Archivable = true
            local cl = char:Clone()
            for _, d in ipairs(cl:GetDescendants()) do
                if d:IsA("BaseScript") then d:Destroy()
                elseif d:IsA("BasePart") then d.Anchored = true
                elseif d:IsA("Humanoid") then d.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end
            end
            cl.Parent = vp
            local head = cl:FindFirstChild("Head")
            local cam = Instance.new("Camera")
            cam.FieldOfView = 35
            cam.Parent = vp
            vp.CurrentCamera = cam
            cam.CFrame = CFrame.lookAt(head.Position + head.CFrame.LookVector * 3.2 + Vector3.new(0, 0.2, 0), head.Position)
        end)
    end

    local function makeRow(plr)
        local frame = new("Frame", {Size = UDim2.new(1, 0, 0, 56), BackgroundTransparency = 0.45, BorderSizePixel = 0}, p.scroll)
        bindUI(frame, "BackgroundColor3")
        corner(frame, 12)
        local bar = new("Frame", {Size = UDim2.fromOffset(5, 40), Position = UDim2.fromOffset(6, 8), BorderSizePixel = 0}, frame)
        corner(bar, 3)
        local rank = new("TextLabel", {Position = UDim2.fromOffset(14, 0), Size = UDim2.fromOffset(28, 56), BackgroundTransparency = 1,
            Text = "#", Font = Enum.Font.GothamBlack, TextSize = 13, TextColor3 = TEXT}, frame)
        local vpf = new("ViewportFrame", {Position = UDim2.fromOffset(44, 6), Size = UDim2.fromOffset(44, 44),
            BackgroundColor3 = WHITE, BackgroundTransparency = 0.6, BorderSizePixel = 0,
            Ambient = Color3.fromRGB(190, 190, 190), LightColor = WHITE}, frame)
        corner(vpf, 10)
        new("TextLabel", {Position = UDim2.fromOffset(94, 8), Size = UDim2.fromOffset(100, 18), BackgroundTransparency = 1,
            Text = plr.DisplayName, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = TEXT,
            TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd}, frame)
        local teamLb = new("TextLabel", {Position = UDim2.fromOffset(94, 28), Size = UDim2.fromOffset(100, 16), BackgroundTransparency = 1,
            Text = "", Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = SUB,
            TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd}, frame)
        local statsL = new("TextLabel", {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 8), Size = UDim2.fromOffset(150, 40),
            BackgroundTransparency = 1, Text = "", Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = TEXT,
            TextXAlignment = Enum.TextXAlignment.Right, TextYAlignment = Enum.TextYAlignment.Center}, frame)
        local row = {frame = frame, bar = bar, rank = rank, vp = vpf, teamL = teamLb, statsL = statsL, vpT = 0}
        rows[plr] = row
        return row
    end

    local function refreshBoard()
        local list = {}
        for _, plr in ipairs(Players:GetPlayers()) do
            local stats, score = {}, 0
            local ls = plr:FindFirstChild("leaderstats")
            if ls then
                for _, v in ipairs(ls:GetChildren()) do
                    local n = v:IsA("ValueBase") and tonumber(v.Value)
                    if n then table.insert(stats, {v.Name, n}); score += n end
                end
            end
            table.insert(list, {plr = plr, stats = stats, score = score})
        end
        table.sort(list, function(a, b) return a.score > b.score end)
        local seen = {}
        for rank, e in ipairs(list) do
            local plr = e.plr
            seen[plr] = true
            local row = rows[plr] or makeRow(plr)
            row.frame.LayoutOrder = rank
            row.rank.Text = "#" .. rank
            row.rank.TextColor3 = rank == 1 and Color3.fromRGB(230, 160, 20) or TEXT
            local tm = plr.Team
            local tc = tm and tm.TeamColor.Color or OFFC
            row.bar.BackgroundColor3 = tc
            row.teamL.Text = tm and tm.Name or T("No Team")
            row.teamL.TextColor3 = tm and tc or SUB
            local parts = {}
            for i, s in ipairs(e.stats) do
                if i <= 4 then parts[#parts + 1] = s[1] .. " " .. fmt(s[2]) end
            end
            row.statsL.Text = table.concat(parts, "  •  ", 1, math.min(2, #parts)) .. "\n" .. (#parts > 2 and table.concat(parts, "  •  ", 3, #parts) or "")
            if tick() - row.vpT > 12 then
                row.vpT = tick()
                setRowViewport(row.vp, plr)
            end
        end
        for plr, row in pairs(rows) do
            if not seen[plr] then row.frame:Destroy(); rows[plr] = nil end
        end
    end

    task.spawn(function()
        while alive do
            if isOpen and currentKey == "board" then pcall(refreshBoard) end
            task.wait(1.5)
        end
    end)
    p.onShow = function() pcall(refreshBoard) end
    pages.board = p
end

