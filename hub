local ESP = {}
do
local espTagged, espHooks = {}, {}
local scanQueued = false
local espScan

local function espColor(kind)
    local t = (kind == "p" and S.espGreen) or (kind == "i" and S.espBlue) or S.espOrange
    return Color3.fromRGB(t[1], t[2], t[3])
end
local function kindOn(kind)
    return (kind == "p" and S.tPlayers) or (kind == "i" and S.tItems) or (kind == "h" and S.tHalloween) or false
end
local function trOf(kind)
    return (kind == "p" and S.trP) or (kind == "i" and S.trI) or S.trH
end
local function espAdd(obj, kind)
    if not (obj:IsA("Model") or obj:IsA("BasePart")) then return end
    local e = espTagged[obj]
    if e then e.kind = kind; return end
    local h = Instance.new("Highlight")
    h.Name = "ESP_HL"
    h.Adornee = obj
    h.FillTransparency = trOf(kind)
    h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = obj
    espTagged[obj] = {h = h, kind = kind}
end
local function espClear()
    for o, e in pairs(espTagged) do e.h:Destroy(); espTagged[o] = nil end
end
local function espUnhook()
    for f, c in pairs(espHooks) do c:Disconnect(); espHooks[f] = nil end
end
local function queueScan()
    if scanQueued or not S.espOn then return end
    scanQueued = true
    task.delay(0.25, function()
        scanQueued = false
        if alive and S.espOn then pcall(espScan) end
    end)
end
local function hook(f, descendants)
    if not f or espHooks[f] then return end
    espHooks[f] = (descendants and f.DescendantAdded or f.ChildAdded):Connect(queueScan)
end
espScan = function()
    local chars = workspace:FindFirstChild("Characters")
    if chars then
        hook(chars, false)
        if S.tPlayers then
            for _, c in ipairs(chars:GetChildren()) do
                if c ~= player.Character then espAdd(c, "p") end
            end
        end
    end
    local items = workspace:FindFirstChild("Items")
    if items then
        hook(items, false)
        if S.tItems then
            for _, i in ipairs(items:GetChildren()) do espAdd(i, "i") end
        end
    end
    local fx = workspace:FindFirstChild("Effects")
    if fx then
        hook(fx, true)
        if S.tHalloween then
            local d = fx:GetChildren()[S.espIdx]
            if d then espAdd(d, "h") end
            for _, o in ipairs(fx:GetDescendants()) do
                if o.Name:lower():find("halloween", 1, true) then espAdd(o, "h") end
            end
        end
    end
    local n = 0
    for obj, e in pairs(espTagged) do
        if not obj.Parent or not kindOn(e.kind) then
            e.h:Destroy(); espTagged[obj] = nil
        else
            n += 1
            local c = espColor(e.kind)
            e.h.FillColor, e.h.OutlineColor = c, c
            e.h.FillTransparency = trOf(e.kind)
        end
    end
    return n
end

