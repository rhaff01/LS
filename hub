local function addSlider(card, y, text, min, max, step, get, set)
    rowLabel(card, y, text)
    local function show_text(v)
        if step >= 1 then return string.format("%.0f", v) end
        return string.format("%.2f", v)
    end
    local val = new("TextLabel", {BackgroundTransparency = 1, Position = UDim2.new(1, -72, 0, y), Size = UDim2.fromOffset(60, 26),
        Text = "", Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = TEXT, TextXAlignment = Enum.TextXAlignment.Right}, card)
    local trk = new("Frame", {Position = UDim2.fromOffset(14, y + 29), Size = UDim2.new(1, -28, 0, 6),
        BackgroundColor3 = OFFC, BorderSizePixel = 0}, card)
    corner(trk, 3)
    local fill = new("Frame", {Size = UDim2.fromScale(0, 1), BorderSizePixel = 0}, trk)
    corner(fill, 3)
    bindAccent(fill, "BackgroundColor3")
    local knob = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(16, 16),
        BackgroundColor3 = WHITE, BorderSizePixel = 0}, trk)
    corner(knob, 8)
    bindAccent(new("UIStroke", {Thickness = 2}, knob), "Color")
    local hit = new("TextButton", {Position = UDim2.fromOffset(6, y + 20), Size = UDim2.new(1, -12, 0, 24),
        BackgroundTransparency = 1, Text = "", AutoButtonColor = false}, card)
    local function show()
        local v = get()
        local a = math.clamp((v - min) / (max - min), 0, 1)
        fill.Size = UDim2.fromScale(a, 1)
        knob.Position = UDim2.new(a, 0, 0.5, 0)
        val.Text = show_text(v)
    end
    show()
    local dragging = false
    local function setFromX(x)
        local a = math.clamp((x - trk.AbsolutePosition.X) / math.max(1, trk.AbsoluteSize.X), 0, 1)
        local v = min + a * (max - min)
        v = math.clamp(math.floor(v / step + 0.5) * step, min, max)
        set(tonumber(string.format("%.3f", v)))
        show()
    end
    hit.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            if card.Parent and card.Parent:IsA("ScrollingFrame") then card.Parent.ScrollingEnabled = false end
            setFromX(i.Position.X)
        end
    end)
    track(UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            setFromX(i.Position.X)
        end
    end))
    track(UIS.InputEnded:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            if card.Parent and card.Parent:IsA("ScrollingFrame") then card.Parent.ScrollingEnabled = true end
            save()
        end
    end))
end

