    local function setAnimations(char, d)
        local anim = char:FindFirstChild("Animate")
        if not anim then return end
        if not animSnap then
            animSnap = {}
            for _, a in ipairs(anim:GetDescendants()) do
                if a:IsA("Animation") then animSnap[a] = a.AnimationId end
            end
        end
        local map = {
            {"idle", "Animation1", "IdleAnimation"}, {"idle", "Animation2", "IdleAnimation"},
            {"walk", "WalkAnim", "WalkAnimation"}, {"run", "RunAnim", "RunAnimation"},
            {"jump", "JumpAnim", "JumpAnimation"}, {"fall", "FallAnim", "FallAnimation"},
            {"climb", "ClimbAnim", "ClimbAnimation"}, {"swim", "Swim", "SwimAnimation"},
        }
        local changed = false
        for _, m in ipairs(map) do
            local ok, id = pcall(function() return d[m[3]] end)
            if ok and type(id) == "number" and id ~= 0 then
                local folder = anim:FindFirstChild(m[1])
                local a = folder and folder:FindFirstChild(m[2])
                if a then
                    a.AnimationId = "rbxassetid://" .. string.format("%.0f", id)
                    changed = true
                end
            end
        end
        if changed then reloadAnimate(char) end
    end
    local function restoreAnims(char)
        if not animSnap then return end
        for a, id in pairs(animSnap) do
            if a.Parent then a.AnimationId = id end
        end
        animSnap = nil
        reloadAnimate(char)
    end

    local function applyPack(pack, mode, accList)
        local char, hum = myChar()
        if not char or not hum then return false end
        local r6 = hum.RigType == Enum.HumanoidRigType.R6
        local keepList = {}
        if mode == "merge" and not r6 then
            for _, a in ipairs(char:GetChildren()) do
                if a:IsA("Accessory") then
                    local ok, c = pcall(function() return a:Clone() end)
                    if ok then table.insert(keepList, c) end
                end
            end
        end
        local baseOk = false
        if not r6 then
            local d = pack.desc:Clone()
            pcall(function() d:SetAccessories({}, true) end)
            baseOk = pcall(function() hum:ApplyDescription(d) end)
            d:Destroy()
        end
        if mode == "wear" or not r6 then
            for _, a in ipairs(char:GetChildren()) do
                if a:IsA("Accessory") then a:Destroy() end
            end
        end
        if r6 or not baseOk then
            for _, v in ipairs(char:GetChildren()) do
                if v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") or v:IsA("BodyColors") or (r6 and v:IsA("CharacterMesh")) then
                    v:Destroy()
                end
            end
            for _, v in pairs(pack.classic) do v:Clone().Parent = char end
            if pack.colors then
                local bc = pack.colors:Clone()
                bc.Parent = char
                BodyColorSet(char, bc)
            end
            if r6 then
                for _, m in ipairs(pack.charMeshes) do m:Clone().Parent = char end
                local head = char:FindFirstChild("Head")
                if head then
                    local oldFace = head:FindFirstChildOfClass("Decal")
                    if oldFace then oldFace:Destroy() end
                    if pack.face then pack.face:Clone().Parent = head end
                    if pack.headMesh and head:IsA("Part") then
                        local om = head:FindFirstChildOfClass("SpecialMesh")
                        if om then om:Destroy() end
                        pack.headMesh:Clone().Parent = head
                    end
                end
            end
        end
        setAnimations(char, pack.desc)
        local skipped = 0
        local attMap
        if r6 then
            AttachmentCreate(char)
            attMap = CharacterFunction(char)
        end
        local function addOne(tmpl)
            if r6 then
                if hasWrap(tmpl) then
                    skipped += 1
                    return
                end
                AccessoryAdd(char, tmpl:Clone(), attMap)
            else
                addR15(hum, tmpl)
            end
        end
        for _, t in ipairs(keepList) do addOne(t) end
        for _, t in ipairs(accList) do addOne(t) end
        return true, skipped, r6
    end

